EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_SHOW_CONNECTION_SETTINGS=false

# Para o APK de apresentação, mantenha USE_MOCKS=false.
# A alteração da URL no app é restrita ao administrador autenticado.
# Sem servidor configurado, a cópia real da Prefeitura continua disponível offline.
# Para distribuição pública: URL HTTPS fixa e SHOW_CONNECTION_SETTINGS=false.
