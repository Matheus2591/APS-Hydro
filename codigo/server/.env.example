# Use um arquivo fora do OneDrive para a apresentação.
# PowerShell: $env:DB_PATH = "$env:LOCALAPPDATA\HydroPulse\hydro-pulse.db"
DB_PATH=./data/hydro-pulse.db
PORT=3000
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
MAINTENANCE_ENABLED=true
# Opcional: diretório privado de backups consistentes. Padrão: ao lado do banco.
# BACKUP_DIRECTORY=./data/backups
# Opcional: origens HTTPS ou HTTP locais exatas, separadas por vírgula.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
