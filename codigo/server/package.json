{
  "name": "hydro-pulse-server",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "import:official": "node --env-file-if-exists=.env --import tsx src/cli.ts import",
    "refresh:official": "node --env-file-if-exists=.env --import tsx src/cli.ts refresh",
    "source:fail": "node --env-file-if-exists=.env --import tsx src/cli.ts source-fail",
    "demo:seed": "node --env-file-if-exists=.env --import tsx src/cli.ts seed",
    "demo:idempotency": "node --env-file-if-exists=.env --import tsx src/cli.ts idempotency",
    "backup": "node --env-file-if-exists=.env --import tsx src/cli.ts backup",
    "reset:presentation": "node --env-file-if-exists=.env --import tsx src/cli.ts reset-presentation"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.28.2": true
  }
}
